<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>AlienFix</vendor>
  <action id="io.github.zeecka.alienfix.control">
    <description>Change the keyboard and chassis lighting</description>
    <description xml:lang="fr">Modifier l'éclairage du clavier et du châssis</description>
    <message>Authentication is required to change the lighting</message>
    <message xml:lang="fr">Une authentification est nécessaire pour modifier l'éclairage</message>
    <defaults>
      <!-- remote (SSH...) or background sessions: no; active local session: yes -->
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
