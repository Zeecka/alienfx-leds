#!/usr/bin/python3
"""alienfix: command line client for alienfixd (system bus, polkit-authorised).

  alienfix status | layout | zones
  alienfix color '#ff0000'              whole keyboard
  alienfix keys Q=#ff0000 L=#00ff00     per key, evdev names (see `alienfix layout`)
  alienfix effect wave [--tempo 5] [#c1] [#c2]
  alienfix brightness 60
  alienfix zone power '#ffffff'         zone ids: see `alienfix zones`
  alienfix zone lid pulse [--tempo 6] [#c1] [#c2]
  alienfix models                       the model catalogue (* = active)
  alienfix model dell-g15-5520 | auto   use that model's lighting map
  alienfix on | off
"""
import json
import os
import sys

from gi.repository import Gio, GLib

NAME, PATH, IFACE = "io.github.zeecka.AlienFix", "/io/github/zeecka/AlienFix", "io.github.zeecka.AlienFix1"


def rgb(s):
    s = s.lstrip("#")
    if len(s) != 6:
        raise SystemExit(f"colour {s!r}: use #rrggbb")
    return tuple(int(s[i:i + 2], 16) for i in (0, 2, 4))


def call(method, sig=None, *args):
    bus = Gio.BusType.SESSION if os.environ.get("ALIENFIX_BUS") == "session" else Gio.BusType.SYSTEM
    conn = Gio.bus_get_sync(bus, None)
    try:
        r = conn.call_sync(NAME, PATH, IFACE, method, GLib.Variant(sig, args) if sig else None,
                           None, Gio.DBusCallFlags.ALLOW_INTERACTIVE_AUTHORIZATION, 10000, None)
    except GLib.Error as e:
        name = Gio.DBusError.get_remote_error(e) or ""
        Gio.DBusError.strip_remote_error(e)            # strips in place, returns a bool
        raise SystemExit(f"alienfix: {name.rsplit('.', 1)[-1]}: {e.message.split(': ', 1)[-1]}")
    return r.unpack() if r else ()


def layout():
    return json.loads(call("GetLayout")[0])


def ids_by_key(lay):
    by = {}
    for kid, k in lay["keys"].items():
        by.setdefault(k["name"], []).append(int(kid))
    return by


def tempo_colours(args, tempo, c1, c2):
    """[--tempo N] [#c1] [#c2] in any order -> (tempo, c1, c2)."""
    cols, i = [], 0
    while i < len(args):
        if args[i] == "--tempo":
            tempo, i = int(args[i + 1]), i + 2
        else:
            cols.append(rgb(args[i]))
            i += 1
    cols += [c1, c2][len(cols):]
    return tempo, cols[0], cols[1]


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return
    cmd, rest = argv[0], argv[1:]
    if cmd == "status":
        print(json.dumps(json.loads(call("GetState")[0]), indent=1))
    elif cmd == "layout":
        lay = layout()
        for kid, k in sorted(lay["keys"].items(), key=lambda kv: (kv[1]["row"], kv[1]["u"])):
            print(f"{kid:>4}  {k['name']:<11} {k['legend']}")
    elif cmd == "color":
        call("SetKeyboardColor", "(yyy)", *rgb(rest[0]))
    elif cmd == "keys":
        by = ids_by_key(layout())
        entries = []
        for a in rest:
            name, col = a.split("=")
            if name.upper() not in by:
                raise SystemExit(f"unknown key {name!r} (see `alienfix layout`)")
            entries += [(i, *rgb(col)) for i in by[name.upper()]]
        call("SetKeys", "(a(yyyy))", entries)
    elif cmd == "effect":
        call("SetKeyboardEffect", "(sy(yyy)(yyy))", rest[0],
             *tempo_colours(rest[1:], 5, (0, 90, 255), (255, 0, 160)))
    elif cmd == "brightness":
        call("SetBrightness", "(y)", int(rest[0]))
    elif cmd == "zones":
        lay = layout()
        print(f"model: {lay['model']['name']} ({lay['model']['support']})")
        for z in lay["zones"]:
            print(f"  {z['id']:<8} {z['label']:<40} {'/'.join(z['effects']):<20} "
                  f"{'verified' if z['verified'] else 'not verified'}")
    elif cmd == "zone" and len(rest) >= 2 and rest[1].startswith("#"):
        call("SetZoneColor", "(syyy)", rest[0], *rgb(rest[1]))
    elif cmd == "zone":
        call("SetZoneEffect", "(ssy(yyy)(yyy))", rest[0], rest[1],
             *tempo_colours(rest[2:], 6, (0, 90, 255), (0, 0, 0)))
    elif cmd == "models":
        info = json.loads(call("ListChassis")[0])
        print(f"product name: {info['dmi_product'] or '?'}   controllers: "
              f"{', '.join(k for k, v in info['devices'].items() if v is True) or 'none'}")
        for m in sorted(info["models"], key=lambda m: m["name"].lower()):
            mark = "*" if m["id"] == info["model"] else " "
            print(f" {mark} {m['id']:<34} {m['name']:<36} {m['support']}")
        if info["model"] == "generic":
            print(" * generic (nothing matched this machine)")
    elif cmd == "model":
        call("SelectModel", "(s)", "" if rest[0] == "auto" else rest[0])
    elif cmd in ("on", "off"):
        call("SetEnabled", "(b)", cmd == "on")
    else:
        raise SystemExit(f"unknown command {cmd!r}; see alienfix --help")


if __name__ == "__main__":
    main(sys.argv[1:])
