class MainWindow(Adw.ApplicationWindow):
    def __init__(self, app, start_page):
        super().__init__(application=app, title=APP_NAME, default_width=1180, default_height=800)
        self.start_page = start_page
        self.client = Client(self.on_state, self.on_owner, self.on_layout)
        self.evdev_names = load_evdev_names()
        self.layout = None
        self.chassis_templates = {}
        self.pages = []
        self.last_state = None
        self.syncing = False
        self.brightness_debounce = Debounce(150, lambda: self.call(
            "SetBrightness", GLib.Variant("(y)", (int(self.brightness.get_value()),))))

        self.toasts = Adw.ToastOverlay()
        toolbar = Adw.ToolbarView()
        self.toasts.set_child(toolbar)
        self.set_content(self.toasts)
        header = Adw.HeaderBar()
        self.stack = Adw.ViewStack()
        header.set_title_widget(Adw.ViewSwitcher(stack=self.stack, policy=Adw.ViewSwitcherPolicy.WIDE))
        general = Gtk.Box(spacing=8)
        general.append(Gtk.Label(label="Lighting"))
        self.enabled = Gtk.Switch(valign=Gtk.Align.CENTER, active=True)
        self.enabled.connect("notify::active", self._on_enabled)
        general.append(self.enabled)
        header.pack_start(general)
        bright = Gtk.Box(spacing=6)
        bright.append(Gtk.Image(icon_name="display-brightness-symbolic", tooltip_text="Brightness"))
        self.brightness = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.brightness.set_size_request(170, -1)
        self.brightness.set_draw_value(True)
        self.brightness.set_value_pos(Gtk.PositionType.RIGHT)
        self.brightness.set_tooltip_text("Brightness (0 to 100 %)")
        self.brightness.connect("value-changed", lambda *_: self.syncing or self.brightness_debounce.trigger())
        bright.append(self.brightness)
        header.pack_end(bright)
        self.general_widgets = (general, bright)
        toolbar.add_top_bar(header)
        self.banner = Adw.Banner(title="The alienfixd service is not running", button_label="Retry")
        self.banner.connect("button-clicked", lambda *_: self.connect_daemon())
        toolbar.add_top_bar(self.banner)

        self.main = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        loading = Adw.StatusPage(title="Connecting to alienfixd…")
        loading.set_child(Gtk.Spinner(spinning=True, width_request=32, height_request=32))
        self.main.add_named(loading, "loading")
        self.absent = Adw.StatusPage(icon_name="dialog-warning-symbolic", title="The alienfixd service is not running")
        retry = Gtk.Button(label="Retry", halign=Gtk.Align.CENTER, css_classes=["suggested-action", "pill"])
        retry.connect("clicked", lambda *_: self.connect_daemon())
        self.absent.set_child(retry)
        self.main.add_named(self.absent, "absent")
        self.main.add_named(self.stack, "content")
        toolbar.set_content(self.main)
        self._set_available(False, initial=True)
        self.connect_daemon()

    # --- D-Bus glue ---------------------------------------------------------------
    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=text, timeout=4))

    def call(self, method, params=None, on_done=None):
        def done(res, err):
            if err is not None:
                self.toast(describe_error(err))
                if is_absent_error(err):
                    self._set_available(False)
                elif self.last_state:
                    self.apply_state(self.last_state)
            if on_done:
                on_done(res, err)
        self.client.call(method, params, done)

    def connect_daemon(self):
        if not self.layout:
            self.main.set_visible_child_name("loading")

        def ready(err):
            if err is not None:
                self._set_available(False, detail=describe_error(err))
                return
            self._load()
        self.client.connect(ready)

    def _load(self, rebuild=False):
        def got_layout(res, err):
            if err is not None:
                self._set_available(False, detail=describe_error(err))
                return
            layout = json.loads(res[0])
            self.chassis_templates[layout["chassis"]["id"]] = layout["chassis"]
            if self.layout is None or rebuild:
                self._build_pages(layout)
            self.client.call("GetState", None, got_state)

        def got_state(res, err):
            if err is not None:
                self._set_available(False, detail=describe_error(err))
                return
            self._set_available(True)
            self.apply_state(json.loads(res[0]))
        self.client.call("GetLayout", None, got_layout)

    def on_owner(self, present):
        if present:
            self._load()
        else:
            self._set_available(False)

    def on_layout(self):
        self._load(rebuild=True)

    def _set_available(self, ok, detail=None, initial=False):
        for w in self.general_widgets:
            w.set_sensitive(ok)
        self.banner.set_revealed(not ok and self.layout is not None and not initial)
        if ok:
            self.main.set_visible_child_name("content")
        elif self.layout is None and not initial:
            self.absent.set_description(
                ("" if detail in (None, "The alienfixd service is not running.") else detail + "\n")
                + f"{self.client.bus_label} bus, name {BUS_NAME}. "
                "Check that the service is started (systemctl status alienfixd).")
            self.main.set_visible_child_name("absent")

    def _build_pages(self, layout):
        current = self.stack.get_visible_child_name() if self.pages else self.start_page
        for page in self.pages:
            self.stack.remove(page)
        self.pages = []
        self.layout = layout
        kb_type = layout.get("model", {}).get("keyboard", "per-key")
        zones = layout.get("zones", [])
        chassis_zones = [z for z in zones if z.get("group", "chassis") == "chassis"]
        board = Board.from_layout(layout)
        specs = []
        if kb_type == "per-key":
            specs.append(("keyboard", "Keyboard", "input-keyboard-symbolic", KeyboardPage(self, board)))
        elif kb_type == "zones":
            specs.append(("keyboard", "Keyboard", "input-keyboard-symbolic",
                          ChassisPage(self, [z for z in zones if z.get("group") == "keyboard"],
                                      title="Keyboard zones")))
        specs.append(("effects", "Effects", "starred-symbolic", EffectsPage(self, layout)))
        if chassis_zones:
            specs.append(("chassis", "Chassis", "computer-symbolic", ChassisPage(self, chassis_zones)))
        if kb_type == "per-key" and board.all_ids():
            specs.append(("ripple", "Ripple", "weather-showers-symbolic", RipplePage(self)))
        specs.append(("profile", "Machine", "computer-chip-symbolic", ProfilePage(self, layout)))
        for name, title, icon, page in specs:
            self.stack.add_titled_with_icon(page, name, title, icon)
            self.pages.append(page)
        names = [n for n, *_ in specs]
        self.stack.set_visible_child_name(current if current in names else names[0])
        if self.last_state:
            self.apply_state(self.last_state)

    def open_wizard(self):
        """Fetch the templates list and every template's geometry, then open the wizard."""
        def got(res, err):
            if err is not None:
                return
            info = json.loads(res[0])
            self._fetch_templates(info, lambda: ProfileWizard(self, info, self.evdev_names).present())
        self.call("ListChassis", None, got)

    def _fetch_templates(self, info, then):
        # Geometry of the templates ships with the app as well as with the daemon.
        for d in (Path("/usr/local/share/alienfix/chassis"), Path(__file__).resolve().parent.parent / "data/chassis"):
            for p in d.glob("*.json") if d.is_dir() else []:
                try:
                    t = json.loads(p.read_text())
                    self.chassis_templates.setdefault(t["id"], t)
                except (OSError, ValueError, KeyError):
                    pass
        info["templates"] = [t for t in info["templates"] if t["id"] in self.chassis_templates]
        then()

    def on_state(self, state):
        self._set_available(True)
        self.apply_state(state)

    def apply_state(self, state):
        self.last_state = state
        self.syncing = True
        self.enabled.set_active(bool(state.get("enabled", True)))
        if not self.brightness_debounce.pending:
            self.brightness.set_value(state.get("brightness", 100))
        for page in self.pages:
            page.update(state)
        self.syncing = False

    def _on_enabled(self, switch, _pspec):
        if not self.syncing:
            self.call("SetEnabled", GLib.Variant("(b)", (switch.get_active(),)))



class App(Adw.Application):
    def __init__(self, start_page):
        flags = Gio.ApplicationFlags.DEFAULT_FLAGS
        if os.environ.get("ALIENFIX_BUS") == "session":
            flags |= Gio.ApplicationFlags.NON_UNIQUE
        super().__init__(application_id=APP_ID, flags=flags)
        self.start_page = start_page

    def do_activate(self):
        win = self.get_active_window() or MainWindow(self, self.start_page)
        win.present()


def main(argv):
    parser = argparse.ArgumentParser(description=f"{APP_NAME}: lighting control")
    parser.add_argument("--page", choices=PAGES, default=os.environ.get("ALIENFIX_START_PAGE", "keyboard"),
                        help="page shown at start")
    args, rest = parser.parse_known_args(argv[1:])
    GLib.set_prgname(APP_ID)
    GLib.set_application_name(APP_NAME)
    return App(args.page).run([argv[0]] + rest)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
