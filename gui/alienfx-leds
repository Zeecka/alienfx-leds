def rgba_from_rgb(rgb):
    c = Gdk.RGBA()
    c.red, c.green, c.blue, c.alpha = rgb[0] / 255, rgb[1] / 255, rgb[2] / 255, 1.0
    return c


def rgb_from_rgba(c):
    return tuple(max(0, min(255, int(round(x * 255)))) for x in (c.red, c.green, c.blue))


def color_button(rgb):
    button = Gtk.ColorDialogButton.new(Gtk.ColorDialog(with_alpha=False, modal=True))
    button.set_rgba(rgba_from_rgb(rgb))
    button.set_valign(Gtk.Align.CENTER)
    return button


def plain_row(title, subtitle=None, **kw):
    """Adw.ActionRow that shows text as-is: profile names and legends such as
    "&1" are data, and Pango markup would drop them (or be injectable)."""
    row = Adw.ActionRow(title=title, use_markup=False, **kw)
    if subtitle is not None:
        row.set_subtitle(subtitle)
    return row


def color_row(title, rgb, on_change=None):
    """-> (row, button): a row with a color button at its end."""
    button = color_button(rgb)
    if on_change:
        button.connect("notify::rgba", on_change)
    row = plain_row(title)
    row.add_suffix(button)
    row.set_activatable_widget(button)
    return row, button


class Debounce:
    """Call fn once, ms after the last trigger (sliders, spin buttons)."""

    def __init__(self, ms, fn):
        self.ms, self.fn, self.source = ms, fn, 0

    @property
    def pending(self):
        return bool(self.source)

    def trigger(self, *_):
        if self.source:
            GLib.source_remove(self.source)
        self.source = GLib.timeout_add(self.ms, self._fire)

    def _fire(self):
        self.source = 0
        self.fn()
        return GLib.SOURCE_REMOVE


def rounded_rect(cr, x, y, w, h, r):
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def rounded_poly(cr, pts, r):
    """Closed polygon with rounded corners (used for the ISO Enter L shape)."""
    n = len(pts)
    cr.new_sub_path()
    for i in range(n):
        p0, p1, p2 = pts[i - 1], pts[i], pts[(i + 1) % n]
        v1 = (p0[0] - p1[0], p0[1] - p1[1])
        v2 = (p2[0] - p1[0], p2[1] - p1[1])
        l1, l2 = math.hypot(*v1), math.hypot(*v2)
        rr = min(r, l1 / 2, l2 / 2)
        a = (p1[0] + v1[0] / l1 * rr, p1[1] + v1[1] / l1 * rr)
        b = (p1[0] + v2[0] / l2 * rr, p1[1] + v2[1] / l2 * rr)
        cr.line_to(*a)
        cr.curve_to(p1[0], p1[1], p1[0], p1[1], *b)
    cr.close_path()


def describe_error(err):
    remote = Gio.DBusError.get_remote_error(err) if Gio.DBusError.is_remote_error(err) else None
    msg = re.sub(r"^GDBus\.Error:[\w.]+:\s*", "", err.message)
    if remote == IFACE + ".Error.NotAuthorized":
        return "Not allowed: an active local session is required."
    if remote == IFACE + ".Error.InvalidArgs":
        return f"Rejected by the service: {msg}"
    if is_absent_error(err, remote):
        return "The alienfixd service is not running."
    if remote in ("org.freedesktop.DBus.Error.NoReply", "org.freedesktop.DBus.Error.Timeout") \
            or err.matches(Gio.io_error_quark(), Gio.IOErrorEnum.TIMED_OUT):
        return "The alienfixd service does not answer."
    return f"D-Bus error: {msg}"


def is_absent_error(err, remote=None):
    if remote is None and Gio.DBusError.is_remote_error(err):
        remote = Gio.DBusError.get_remote_error(err)
    return remote in ("org.freedesktop.DBus.Error.ServiceUnknown",
                      "org.freedesktop.DBus.Error.NameHasNoOwner",
                      "org.freedesktop.DBus.Error.UnknownObject") \
        or err.matches(Gio.dbus_error_quark(), Gio.DBusError.SERVICE_UNKNOWN) \
        or err.matches(Gio.dbus_error_quark(), Gio.DBusError.NAME_HAS_NO_OWNER)


# ---------------------------------------------------------------------------
# D-Bus client (async only)
# ---------------------------------------------------------------------------
class Client:
    def __init__(self, on_state, on_owner, on_layout):
        self.bus_type = (Gio.BusType.SESSION if os.environ.get("ALIENFIX_BUS") == "session"
                         else Gio.BusType.SYSTEM)
        self.on_state, self.on_owner, self.on_layout = on_state, on_owner, on_layout
        self.proxy = None
        self.connecting = False

    @property
    def bus_label(self):
        return "session" if self.bus_type == Gio.BusType.SESSION else "system"

    def connect(self, on_ready):
        if self.proxy is not None:
            on_ready(None)
            return
        if self.connecting:
            return
        self.connecting = True

        def done(_src, res):
            self.connecting = False
            try:
                self.proxy = Gio.DBusProxy.new_for_bus_finish(res)
            except GLib.Error as err:
                on_ready(err)
                return
            self.proxy.connect("g-signal", self._on_signal)
            self.proxy.connect("notify::g-name-owner",
                               lambda p, _s: self.on_owner(p.get_name_owner() is not None))
            on_ready(None)

        Gio.DBusProxy.new_for_bus(self.bus_type, Gio.DBusProxyFlags.DO_NOT_LOAD_PROPERTIES, None,
                                  BUS_NAME, OBJ_PATH, IFACE, None, done)

    @property
    def available(self):
        return self.proxy is not None and self.proxy.get_name_owner() is not None

    def call(self, method, params=None, on_done=None):
        """Async call; on_done(result_tuple_or_None, GLib.Error_or_None)."""
        if self.proxy is None:
            if on_done:
                err = GLib.Error.new_literal(Gio.dbus_error_quark(), "bus unavailable",
                                             Gio.DBusError.SERVICE_UNKNOWN)
                GLib.idle_add(lambda: (on_done(None, err), False)[1])
            return

        def done(proxy, res):
            try:
                result = proxy.call_finish(res).unpack()
            except GLib.Error as err:
                if on_done:
                    on_done(None, err)
                return
            if on_done:
                on_done(result, None)

        self.proxy.call(method, params, Gio.DBusCallFlags.NONE, -1, None, done)

    def _on_signal(self, _proxy, _sender, signal, params):
        if signal == "StateChanged":
            try:
                self.on_state(json.loads(params.unpack()[0]))
            except (ValueError, IndexError):
                pass
        elif signal == "LayoutChanged":
            self.on_layout()


# ---------------------------------------------------------------------------
# Keyboard drawing
# ---------------------------------------------------------------------------
class KeyboardView(Gtk.DrawingArea):
    """The chassis keyboard, drawn to scale from its template.

    mode "select": click/Ctrl-click selects keys;
    "pick": a click calls on_pick(name) (used by the profile wizard).
    """

    SELECT = (0.30, 0.62, 1.0)
    UNLIT = (0.22, 0.22, 0.25)
    GAP = 0.07          # u between keys

    def __init__(self, board, mode="select"):
        super().__init__(hexpand=True, vexpand=True)
        self.board, self.mode = board, mode
        self.colors = {}           # id -> (r, g, b)
        self.cap_colors = {}       # key name -> (r, g, b), wizard marks
        self.selected = set()
        self.target = None          # key name to outline (wizard: last assigned)
        self.on_selection_changed = None
        self.on_pick = None
        self._scale = 1
        self._origin = (0, 0)
        self.set_content_width(900)
        self.set_content_height(330)
        self.set_draw_func(self._draw)
        self.set_has_tooltip(True)
        self.connect("query-tooltip", self._on_tooltip)
        click = Gtk.GestureClick()
        click.connect("pressed", self._on_click)
        self.add_controller(click)

    # --- public -------------------------------------------------------------
    def set_board(self, board):
        self.board = board
        self.selected.clear()
        self.queue_draw()

    def set_colors(self, colors):
        self.colors = colors
        self.queue_draw()

    def set_cap_colors(self, colors):
        self.cap_colors = colors
        self.queue_draw()

    def set_selection(self, names):
        self.selected = set(names)
        self.queue_draw()
        if self.on_selection_changed:
            self.on_selection_changed()

    def select_all(self):
        self.set_selection(n for n, c in self.board.caps.items() if c.ids)

    def selected_ids(self):
        return sorted(i for n in self.selected for i in self.board.caps[n].ids)

    # --- geometry -----------------------------------------------------------
    def _to_units(self, x, y):
        (ox, oy), s = self._origin, self._scale
        return (x - ox) / s, (y - oy) / s

    def _hit(self, x, y):
        u, v = self._to_units(x, y)
        for cap in self.board.caps.values():
            for rx, ry, rw, rh in cap.rects:
                if rx <= u <= rx + rw and ry <= v <= ry + rh:
                    return cap
        return None

    # --- events -------------------------------------------------------------
    def _on_click(self, gesture, _n, x, y):
        cap = self._hit(x, y)
        if self.mode == "pick":
            if cap is not None and self.on_pick:
                self.on_pick(cap.name)
            return
        multi = bool(gesture.get_current_event_state()
                     & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.SHIFT_MASK))
        if cap is None or not cap.ids:
            if cap is None and not multi:
                self.set_selection(())
            return
        if multi:
            self.set_selection(self.selected ^ {cap.name})
        elif self.selected == {cap.name}:
            self.set_selection(())
        else:
            self.set_selection({cap.name})

    def _on_tooltip(self, _w, x, y, _kbd, tooltip):
        cap = self._hit(x, y)
        if cap is None:
            return False
        label = cap.legend or cap.name.title()
        if cap.ids:
            text = f"{label} — {cap.name} (LED id {', '.join(map(str, cap.ids))})"
        else:
            text = f"{label} — {cap.name} (no LED in this profile)"
        if cap.name in self.board.no_keycode:
            text += "\nHas an LED but sends no keycode"
        tooltip.set_text(text)
        return True

    # --- drawing ------------------------------------------------------------
    def _color_of(self, cap):
        if cap.name in self.cap_colors:
            return tuple(c / 255 for c in self.cap_colors[cap.name])
        for kid in cap.ids:
            if kid in self.colors:
                return tuple(c / 255 for c in self.colors[kid])
        return None

    def _outline(self, cr, cap, s, ox, oy):
        """Path of the keycap: one rounded rect, or an L polygon for ISO Enter."""
        g = self.GAP / 2
        r = s * 0.1
        rects = [((x + g) * s + ox, (y + g) * s + oy, (w - 2 * g) * s, (h - 2 * g) * s)
                 for x, y, w, h in cap.rects]
        if len(rects) == 2:
            (ax, ay, aw, ah), (bx, by, bw, bh) = rects
            right = ax + aw
            if abs(right - (bx + bw)) < 1 and by > ay:      # right-aligned L (ISO Enter)
                pts = [(ax, ay), (right, ay), (right, by + bh), (bx, by + bh), (bx, ay + ah), (ax, ay + ah)]
                rounded_poly(cr, pts, r)
                return (min(ax, bx), ay, right - min(ax, bx), by + bh - ay), (ax, ay, aw, ah)
        for x, y, w, h in rects:
            rounded_rect(cr, x, y, w, h, r)
        return rects[0], rects[0]

    def _draw(self, _area, cr, width, height):
        pad = 0.3
        bw, bh = self.board.width + 2 * pad, self.board.height + 2 * pad
        s = min(width / bw, height / bh)
        ox = (width - s * bw) / 2 + pad * s
        oy = (height - s * bh) / 2 + pad * s
        self._scale, self._origin = s, (ox, oy)

        rounded_rect(cr, ox - pad * s, oy - pad * s, bw * s, bh * s, s * 0.35)
        cr.set_source_rgb(0.085, 0.085, 0.10)
        cr.fill()

        for cap in self.board.caps.values():
            fill = self._color_of(cap)
            no_led = not cap.ids and cap.name not in self.cap_colors and self.mode != "pick"
            lit = fill is not None and sum(fill) > 0.15
            base = fill or ((0.14, 0.14, 0.16) if no_led else self.UNLIT)
            if lit:                                   # glow
                cr.save()
                self._outline(cr, cap, s, ox, oy)
                cr.set_source_rgba(*base, 0.35)
                cr.set_line_width(s * 0.12)
                cr.stroke()
                cr.restore()
            box, label_box = self._outline(cr, cap, s, ox, oy)
            cr.set_source_rgb(*base)
            cr.fill_preserve()
            if no_led:
                cr.set_dash([4, 3])
                cr.set_source_rgba(1, 1, 1, 0.22)
            else:
                cr.set_source_rgba(1, 1, 1, 0.13)
            cr.set_line_width(1)
            cr.stroke()
            cr.set_dash([])

            lum = 0.2126 * base[0] + 0.7152 * base[1] + 0.0722 * base[2]
            ink = (0.08, 0.08, 0.1) if lum > 0.55 else ((0.55, 0.55, 0.58) if no_led else (0.95, 0.95, 0.97))
            text = cap.legend
            if cap.name == "SPACE" and no_led:
                text = "Space · no LED"
            lx, ly, lw, lh = label_box
            self._draw_legend(cr, text, lx, ly, lw, lh, s * (0.24 if lh > s * 0.6 else 0.2), ink)

            if cap.name in self.board.no_keycode and cap.ids:
                cr.new_sub_path()
                cr.arc(lx + lw - s * 0.14, ly + s * 0.13, s * 0.055, 0, 2 * math.pi)
                cr.set_source_rgb(1.0, 0.72, 0.15)
                cr.fill()
            if cap.name in self.selected or cap.name == self.target:
                self._outline(cr, cap, s, ox, oy)
                cr.set_source_rgb(*self.SELECT)
                cr.set_line_width(max(2.5, s * 0.06))
                cr.stroke()

    @staticmethod
    def _draw_legend(cr, text, x, y, w, h, px, ink):
        if not text:
            return
        layout = PangoCairo.create_layout(cr)
        font = Pango.FontDescription.from_string("Sans Bold")
        font.set_absolute_size(px * Pango.SCALE)
        layout.set_font_description(font)
        layout.set_text(text, -1)
        tw, th = layout.get_pixel_size()
        if tw > w - 6:
            font.set_absolute_size(px * (w - 6) / tw * Pango.SCALE)
            layout.set_font_description(font)
            tw, th = layout.get_pixel_size()
        cr.move_to(x + (w - tw) / 2, y + (h - th) / 2)
        cr.set_source_rgb(*ink)
        PangoCairo.show_layout(cr, layout)


