class ProfileWizard(Adw.Window):
    BLINK_MS = 320

    def __init__(self, win, info, evdev_names):
        super().__init__(transient_for=win, modal=True, title="New PC profile",
                         default_width=1100, default_height=760)
        self.win, self.info, self.evdev_names = win, info, evdev_names
        self.templates = {t["id"]: t for t in info["templates"]}
        self.assign = {}                    # key name -> [ids]
        self.history = []                   # [(id, key name or None)]
        self.ids, self.pos = [], 0
        self.blink_on, self.timer = False, 0
        self.live = False
        self.key_ctrl = None

        view = Adw.ToolbarView()
        header = Adw.HeaderBar()
        view.add_top_bar(header)
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        view.set_content(self.stack)
        self.toasts = Adw.ToastOverlay(child=view)
        self.set_content(self.toasts)
        self.stack.add_named(self._setup_page(), "setup")
        self.stack.add_named(self._blink_page(), "blink")
        self.stack.add_named(self._review_page(), "review")
        self.connect("close-request", self._on_close)

    # --- step 1: setup --------------------------------------------------------
    def _setup_page(self):
        page = Adw.PreferencesPage()
        intro = Adw.PreferencesGroup(
            title="Does it blink?",
            description="AlienFX LEDs will make every LED id blink white, one at a time, on a dark "
                        "keyboard. Click the key that blinks on the drawing, or simply press it on "
                        "your keyboard. If nothing lights up, answer “Nothing blinks”. Keys with an "
                        "LED but no keycode (like Fn) must be clicked. While the wizard runs, it "
                        "reads key presses in its own window only.")
        page.add(intro)
        group = Adw.PreferencesGroup(title="Your machine")
        page.add(group)
        product = self.info.get("dmi_product") or "unknown"
        group.add(plain_row("Detected model", subtitle=product))
        tids = list(self.templates)
        self.tpl_combo = Adw.ComboRow(title="Keyboard (chassis template)", model=Gtk.StringList.new(
            [self.templates[t]["name"] + ("" if self.templates[t].get("verified") else " — derived")
             for t in tids]))
        self.tpl_ids = tids
        match = [i for i, t in enumerate(tids) if product in (self.templates[t].get("dmi_product") or [])]
        if match:
            self.tpl_combo.set_selected(match[0])
        group.add(self.tpl_combo)
        self.name_row = Adw.EntryRow(title="Profile name")
        self.name_row.set_text(f"{product} (blink test)"[:60] if product != "unknown" else "My PC")
        group.add(self.name_row)
        self.range_combo = Adw.ComboRow(title="LED ids to test", model=Gtk.StringList.new(
            ["0 to 159 — recommended (≈ 3 min)", "0 to 254 — everything (≈ 5 min)"]))
        group.add(self.range_combo)
        start = Gtk.Button(label="Start blinking", halign=Gtk.Align.CENTER, margin_top=12,
                           css_classes=["suggested-action", "pill"])
        start.connect("clicked", self._start)
        group.add(start)
        return page

    # --- step 2: blink ----------------------------------------------------------
    def _blink_page(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                      margin_top=18, margin_bottom=18, margin_start=18, margin_end=18)
        self.prompt = Gtk.Label(xalign=0, css_classes=["title-2"])
        box.append(self.prompt)
        box.append(Gtk.Label(xalign=0, wrap=True, css_classes=["dim-label"],
                             label="Look at your keyboard: one LED blinks white. Click that key below "
                                   "or press it. Green keys are already mapped."))
        self.progress = Gtk.ProgressBar(show_text=True)
        box.append(self.progress)
        self.view = KeyboardView(Board({"width": 1, "height": 1, "keys": []}), mode="pick")
        self.view.on_pick = self._answer
        box.append(Gtk.Frame(child=self.view, css_classes=["view"]))
        self.last_label = Gtk.Label(xalign=0, css_classes=["monospace", "dim-label"])
        box.append(self.last_label)
        bar = Gtk.Box(spacing=8)
        back = Gtk.Button(child=Adw.ButtonContent(icon_name="go-previous-symbolic", label="Back"),
                          tooltip_text="Undo the last answer")
        back.connect("clicked", self._back)
        nothing = Gtk.Button(label="Nothing blinks", css_classes=["pill"])
        nothing.connect("clicked", lambda *_: self._answer(None))
        finish = Gtk.Button(label="Finish now")
        finish.connect("clicked", lambda *_: self._to_review())
        for w in (back, Gtk.Box(hexpand=True), nothing, finish):
            bar.append(w)
        box.append(bar)
        return box

    def _start(self, *_):
        tid = self.tpl_ids[self.tpl_combo.get_selected()]
        self.template = self.win.chassis_templates.get(tid)
        if not self.template:
            self.toasts.add_toast(Adw.Toast(title="Template geometry not available."))
            return
        top = 159 if self.range_combo.get_selected() == 0 else MAX_ID
        self.ids, self.pos = list(range(top + 1)), 0
        self.assign, self.history = {}, []
        self.board = Board(self.template)
        self.view.set_board(self.board)
        self.stack.set_visible_child_name("blink")
        self.key_ctrl = Gtk.EventControllerKey()
        self.key_ctrl.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        self.key_ctrl.connect("key-pressed", self._on_key)
        self.add_controller(self.key_ctrl)
        self.win.client.call("BeginLive", None, self._on_begun)

    def _on_begun(self, _res, err):
        if err is not None:
            self.toasts.add_toast(Adw.Toast(title=describe_error(err)))
            self.stack.set_visible_child_name("setup")
            return
        self.live = True
        self._send([(i, 0, 0, 0) for i in range(MAX_ID + 1)])      # dark keyboard
        self._show_current()
        self.timer = GLib.timeout_add(self.BLINK_MS, self._blink)

    def _send(self, frame):
        if self.live:
            self.win.client.call("LiveFrame", GLib.Variant("(a(yyyy))", (frame,)))

    def _current(self):
        return self.ids[self.pos] if self.pos < len(self.ids) else None

    def _blink(self):
        kid = self._current()
        if kid is None:
            return GLib.SOURCE_CONTINUE
        self.blink_on = not self.blink_on
        v = 255 if self.blink_on else 0
        self._send([(kid, v, v, v)])
        return GLib.SOURCE_CONTINUE

    def _show_current(self):
        kid = self._current()
        n = len(self.ids)
        mapped = sum(len(v) for v in self.assign.values())
        self.progress.set_fraction(self.pos / n)
        self.progress.set_text(f"{self.pos} / {n} ids tested · {mapped} mapped")
        if kid is None:
            self._to_review()
            return
        self.prompt.set_label(f"LED id {kid} is blinking — which key?")
        self.view.set_cap_colors({name: (40, 170, 90) for name in self.assign})

    def _answer(self, name):
        kid = self._current()
        if kid is None:
            return
        self._send([(kid, 0, 0, 0)])
        if name is not None:
            ids = self.assign.setdefault(name, [])
            if len(ids) >= 4:
                self.toasts.add_toast(Adw.Toast(title=f"{name} already has 4 ids; skipped."))
                name = None
            else:
                ids.append(kid)
        self.history.append((kid, name))
        self.last_label.set_label(f"id {kid} → {name or 'nothing'}")
        self.view.target = name
        self.pos += 1
        self.blink_on = False
        self._show_current()

    def _on_key(self, _ctrl, _keyval, keycode, _state):
        if self.stack.get_visible_child_name() != "blink":
            return False
        name = self.evdev_names.get(keycode - 8)
        if name in self.board.caps:
            self._answer(name)
        else:
            self.toasts.add_toast(Adw.Toast(title=f"Key {name or keycode} is not on this template; click it instead.",
                                            timeout=2))
        return True                          # the wizard swallows key presses (Esc included)

    def _back(self, *_):
        if not self.history:
            return
        self._send([(self._current(), 0, 0, 0)] if self._current() is not None else [])
        kid, name = self.history.pop()
        if name is not None:
            self.assign[name].remove(kid)
            if not self.assign[name]:
                del self.assign[name]
        self.pos -= 1
        self.last_label.set_label(f"undid id {kid}")
        self._show_current()

    # --- step 3: review -----------------------------------------------------------
    def _review_page(self):
        page = Adw.PreferencesPage()
        self.review_group = Adw.PreferencesGroup(title="Review")
        page.add(self.review_group)
        self.sum_mapped = plain_row("Keys mapped")
        self.sum_list = plain_row("Mapping")
        self.sum_list.set_subtitle_lines(4)
        self.sum_missing = plain_row("Keys with no LED found")
        self.sum_missing.set_subtitle_lines(3)
        for r in (self.sum_mapped, self.sum_list, self.sum_missing):
            self.review_group.add(r)
        actions = Adw.PreferencesGroup()
        page.add(actions)
        test = Gtk.Button(label="Test: sweep a rainbow across the mapped keys", halign=Gtk.Align.START)
        test.connect("clicked", self._test)
        actions.add(test)
        again = Gtk.Button(label="Back to blinking", halign=Gtk.Align.START, margin_top=6)
        again.connect("clicked", self._resume)
        actions.add(again)
        save = Gtk.Button(label="Save and use this profile", halign=Gtk.Align.CENTER, margin_top=18,
                          css_classes=["suggested-action", "pill"])
        save.connect("clicked", self._save)
        actions.add(save)
        return page

    def _to_review(self):
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = 0
        if self._current() is not None:
            self._send([(self._current(), 0, 0, 0)])
        total = sum(len(v) for v in self.assign.values())
        self.sum_mapped.set_subtitle(f"{len(self.assign)} keys, {total} LED ids "
                                     f"(out of {self.pos} ids tested)")
        self.sum_list.set_subtitle(", ".join(
            f"{self.board.caps[n].legend or n} → {', '.join(map(str, v))}" for n, v in
            sorted(self.assign.items(), key=lambda kv: kv[1][0])) or "nothing yet")
        missing = [c.legend or n for n, c in self.board.caps.items() if n not in self.assign]
        self.sum_missing.set_subtitle(", ".join(missing) or "none")
        self.stack.set_visible_child_name("review")

    def _resume(self, *_):
        if self._current() is None:
            self.toasts.add_toast(Adw.Toast(title="Every id in the range was tested."))
            return
        self.stack.set_visible_child_name("blink")
        self._show_current()
        self.timer = GLib.timeout_add(self.BLINK_MS, self._blink)

    def _test(self, *_):
        caps = [c for n, c in self.board.caps.items() if n in self.assign]
        if not caps:
            return
        t0 = time.monotonic()

        def step():
            t = time.monotonic() - t0
            if t > 4 or not self.live:
                self._send([(i, 0, 0, 0) for c in caps for i in self.assign[c.name]])
                return GLib.SOURCE_REMOVE
            frame = []
            for c in caps:
                r, g, b = colorsys.hsv_to_rgb((c.u / self.board.width - t * 0.5) % 1, 1, 1)
                frame += [(i, int(r * 255), int(g * 255), int(b * 255)) for i in self.assign[c.name]]
            self._send(frame)
            return GLib.SOURCE_CONTINUE
        GLib.timeout_add(50, step)

    def _save(self, *_):
        name = self.name_row.get_text().strip() or "My PC"
        prof = {"version": 1, "name": name[:60], "chassis": self.template["id"], "method": "blink",
                "keys": {n: sorted(v) for n, v in self.assign.items()}}

        def done(_res, err):
            if err is not None:
                self.toasts.add_toast(Adw.Toast(title=describe_error(err)))
                return
            self.win.toast(f"Profile “{name}” saved and active.")
            self.close()
        if not prof["keys"]:
            self.toasts.add_toast(Adw.Toast(title="No key mapped yet."))
            return
        self.win.client.call("SaveProfile", GLib.Variant("(s)", (json.dumps(prof),)), done)

    def _on_close(self, *_):
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = 0
        if self.key_ctrl is not None:
            self.remove_controller(self.key_ctrl)
            self.key_ctrl = None
        if self.live:
            self.live = False
            self.win.client.call("EndLive")
        return False


