class ProfilePage(Adw.PreferencesPage):
    """The machine: detected model, model choice, and (per-key keyboards) the
    key map: import/export, reset, and the new-PC wizard."""

    def __init__(self, win, layout):
        super().__init__()
        self.win, self.layout = win, layout
        model = layout.get("model", {})
        group = Adw.PreferencesGroup(title="This machine")
        self.add(group)
        self.product_row = plain_row("Detected product name", subtitle="…")
        group.add(self.product_row)
        row = plain_row("Model", subtitle=f"{model.get('name', '?')} · {SUPPORT_TEXT.get(model.get('support'), '')}")
        row.set_subtitle_lines(3)
        group.add(row)
        if model.get("source"):
            src = plain_row("Where the lighting map comes from", subtitle=model["source"])
            src.set_subtitle_lines(4)
            group.add(src)
        self.model_combo = Adw.ComboRow(title="Use the lighting map of",
                                        subtitle="Automatic uses the product name, then the USB id")
        self.model_ids = [""]
        self.model_combo.set_model(Gtk.StringList.new(["Automatic"]))
        group.add(self.model_combo)
        win.call("ListChassis", None, self._got_models)

        if model.get("keyboard", "per-key") == "per-key":
            self._key_map_groups(layout)

    def _got_models(self, res, err):
        if err is not None:
            return
        info = json.loads(res[0])
        self.product_row.set_subtitle(info.get("dmi_product") or "unknown")
        ms = sorted(info.get("models", []), key=lambda m: (m["support"] != "verified", m["name"].lower()))
        self.model_ids = [""] + [m["id"] for m in ms]
        labels = ["Automatic"] + [m["name"] + ("" if m["support"] == "verified" else " (community)")
                                  for m in ms]
        self.model_combo.set_model(Gtk.StringList.new(labels))
        current = info.get("model") if info.get("model_forced") else ""
        self.model_combo.set_selected(self.model_ids.index(current) if current in self.model_ids else 0)
        self.model_combo.connect("notify::selected", self._on_model)

    def _on_model(self, *_):
        i = self.model_combo.get_selected()
        if 0 <= i < len(self.model_ids):
            self.win.call("SelectModel", GLib.Variant("(s)", (self.model_ids[i],)))

    def _key_map_groups(self, layout):
        prof = layout.get("profile", {})
        chassis = layout["chassis"]
        group = Adw.PreferencesGroup(title="Keyboard key map")
        self.add(group)
        mapped = len(Board.from_layout(layout).all_ids())
        row = plain_row("Active key map", subtitle=(
            f"{prof.get('name', '?')} · {'custom' if layout.get('custom') else 'built-in'} · "
            f"{mapped} LED ids · mapped by {'camera' if prof.get('method') == 'camera' else 'blink test'}"
            if mapped else "none yet: create one below"))
        group.add(row)
        tpl = plain_row("Chassis template", subtitle=chassis.get("name", chassis.get("id")))
        if not chassis.get("verified", False):
            tpl.set_subtitle(tpl.get_subtitle() + " (derived, not verified)")
        group.add(tpl)

        create = Adw.PreferencesGroup(
            title="New PC? Create its key map",
            description="Every LED id blinks in turn: you click (or press) the key that blinks, "
                        "or answer “Nothing blinks”. About 3 to 5 minutes, no tools needed.")
        self.add(create)
        start = Gtk.Button(label="Create a key map for this PC…", halign=Gtk.Align.START,
                           css_classes=["suggested-action", "pill"])
        start.connect("clicked", lambda *_: self.win.open_wizard())
        create.add(start)

        manage = Adw.PreferencesGroup(title="Manage")
        self.add(manage)
        exp = plain_row("Export the active key map", subtitle="Share it for the same model",
                            activatable=True)
        exp.add_suffix(Gtk.Image(icon_name="document-save-symbolic"))
        exp.connect("activated", self._export)
        manage.add(exp)
        imp = plain_row("Import a key map…", subtitle="Checked by the service before use",
                            activatable=True)
        imp.add_suffix(Gtk.Image(icon_name="document-open-symbolic"))
        imp.connect("activated", self._import)
        manage.add(imp)
        if layout.get("custom"):
            reset = plain_row("Back to the built-in key map", activatable=True)
            reset.add_suffix(Gtk.Image(icon_name="edit-undo-symbolic"))
            reset.connect("activated", lambda *_: self.win.call("ResetProfile"))
            manage.add(reset)

    def _profile_json(self):
        prof = self.layout.get("profile", {})
        return json.dumps({"version": 1, "name": prof.get("name", "Profile"), "chassis": prof.get("chassis"),
                           "method": prof.get("method", "blink"), "keys": key_ids(self.layout)}, indent=1)

    def _export(self, *_):
        dialog = Gtk.FileDialog(initial_name="alienfx-profile.json")

        def done(d, res):
            try:
                f = d.save_finish(res)
            except GLib.Error:
                return
            f.replace_contents(self._profile_json().encode(), None, False, Gio.FileCreateFlags.NONE, None)
            self.win.toast("Profile exported.")
        dialog.save(self.win, None, done)

    def _import(self, *_):
        dialog = Gtk.FileDialog()

        def done(d, res):
            try:
                f = d.open_finish(res)
                ok, data, _etag = f.load_contents(None)
            except GLib.Error:
                return
            if len(data) > 32768:
                self.win.toast("File too large for a profile.")
                return
            self.win.call("SaveProfile", GLib.Variant("(s)", (data.decode("utf-8", "replace"),)),
                          lambda _r, e: e is None and self.win.toast("Profile imported and active."))
        dialog.open(self.win, None, done)

    def update(self, state):
        pass


