def key_ids(layout):
    """{key name: [LED ids]} of a GetLayout reply."""
    ids = {}
    for kid, k in layout["keys"].items():
        ids.setdefault(k["name"], []).append(int(kid))
    return ids


# ---------------------------------------------------------------------------
# Keyboard model: chassis template + id mapping
# ---------------------------------------------------------------------------
class KeyCap:
    """One physical key of the chassis, with the LED ids the profile maps to it."""

    def __init__(self, name, legend, rects):
        self.name, self.legend, self.rects = name, legend, rects
        self.ids = []
        x, y, w, h = rects[0]
        self.u, self.v = x + w / 2, y + h / 2


class Board:
    """Geometry of a chassis template, optionally with a profile's id mapping."""

    def __init__(self, template, key_ids=None):
        self.template = template
        self.width, self.height = template["width"], template["height"]
        self.no_keycode = set(template.get("no_keycode", []))
        self.no_led = set(template.get("no_led", []))
        self.caps = {}
        for k in template["keys"]:
            cap = self.caps.get(k["name"])
            if cap is None:
                self.caps[k["name"]] = KeyCap(k["name"], k["legend"], [(k["x"], k["y"], k["w"], k["h"])])
            else:
                cap.rects.append((k["x"], k["y"], k["w"], k["h"]))
        for name, ids in (key_ids or {}).items():
            if name in self.caps:
                self.caps[name].ids = sorted(ids)

    @classmethod
    def from_layout(cls, layout):
        return cls(layout["chassis"], key_ids(layout))

    def all_ids(self):
        return sorted(i for c in self.caps.values() for i in c.ids)


