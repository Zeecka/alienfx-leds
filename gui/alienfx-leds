class KeyboardPage(Gtk.Box):
    def __init__(self, win, board):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                         margin_top=18, margin_bottom=18, margin_start=18, margin_end=18)
        self.win = win
        self.info = Gtk.Label(xalign=0, wrap=True, css_classes=["dim-label"])
        self.append(self.info)
        self.view = KeyboardView(board)
        self.view.on_selection_changed = self._on_selection
        self.append(Gtk.Frame(child=self.view, css_classes=["view"]))
        self.append(Gtk.Label(xalign=0, css_classes=["caption", "dim-label"], wrap=True,
                              label="Click: select · Ctrl/Shift+click: multiple selection · "
                                    "orange dot: LED without keycode · dashed: no LED"))
        bar = Gtk.Box(spacing=8)
        all_btn = Gtk.Button(label="Select all")
        all_btn.connect("clicked", lambda *_: self.view.select_all())
        none_btn = Gtk.Button(label="None")
        none_btn.connect("clicked", lambda *_: self.view.set_selection(()))
        self.count = Gtk.Label(css_classes=["dim-label"], margin_start=6)
        for w in (all_btn, none_btn, self.count, Gtk.Box(hexpand=True), Gtk.Label(label="Color")):
            bar.append(w)
        self.color = color_button((255, 60, 0))
        bar.append(self.color)
        self.apply_btn = Gtk.Button(label="Apply to selection", css_classes=["suggested-action"])
        self.apply_btn.connect("clicked", self._apply_selection)
        whole = Gtk.Button(label="Whole keyboard")
        whole.connect("clicked", self._apply_all)
        bar.append(self.apply_btn)
        bar.append(whole)
        self.append(bar)
        self._on_selection()

    def _on_selection(self):
        keys = len(self.view.selected)
        n = len(self.view.selected_ids())
        self.count.set_label("No key selected" if not keys else
                             f"{keys} key{'s' if keys > 1 else ''} ({n} LED{'s' if n > 1 else ''})")
        self.apply_btn.set_sensitive(keys > 0)

    def _apply_selection(self, _btn):
        r, g, b = rgb_from_rgba(self.color.get_rgba())
        self.win.call("SetKeys", GLib.Variant("(a(yyyy))", ([(i, r, g, b) for i in self.view.selected_ids()],)))

    def _apply_all(self, _btn):
        self.win.call("SetKeyboardColor", GLib.Variant("(yyy)", rgb_from_rgba(self.color.get_rgba())))

    def update(self, state):
        kb = state.get("keyboard", {})
        if not self.view.board.all_ids():
            self.info.set_label("No key map for this PC yet. Open Machine → “Create a key map for this "
                                "PC…”: each LED blinks in turn and you show which key it is.")
            return
        if kb.get("mode") == "static":
            base = tuple(kb["base"]) if kb.get("base") else None
            colors = {i: base for i in self.view.board.all_ids()} if base else {}
            colors.update({int(k): tuple(v) for k, v in kb.get("keys", {}).items()})
            self.view.set_colors(colors)
            text = "Static mode: per-key colors."
        else:
            self.view.set_colors({})
            name = EFFECT_LABEL.get(kb.get("effect", {}).get("name"), "?")
            text = (f"Effect running ({name}). Per-key colors are kept by the service; "
                    "applying a color switches back to static mode.")
        if not state.get("enabled", True):
            text += " Lighting is off."
        self.info.set_label(text)


class EffectsPage(Adw.PreferencesPage):
    """One effect, applied to everything or to any subset of the lighting groups."""

    def __init__(self, win, layout):
        super().__init__()
        self.win = win
        self.available = set(layout.get("effects", []))
        self.kb_type = layout.get("model", {}).get("keyboard", "per-key")
        self.zones = {z["id"]: z for z in layout.get("zones", []) if z.get("group", "chassis") == "chassis"}
        self.targets_spec = ([("keyboard", "Keyboard")] if self.kb_type != "none" else []) + \
            [(zid, z["label"].split(" (")[0]) for zid, z in self.zones.items()]   # "Rear LEDs A (…)" -> "Rear LEDs A"
        self.syncing = False
        self.last_effect = None
        self.entries = []

        tgroup = Adw.PreferencesGroup(title="Apply to",
                                      description="Pick one or several lighting groups; the list of "
                                                  "effects follows what they all support.")
        self.add(tgroup)
        self.checks = {}
        row = plain_row("")
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=6, valign=Gtk.Align.CENTER,
                           column_spacing=18, row_spacing=4, hexpand=True, margin_top=6, margin_bottom=6)
        first = self.targets_spec[0][0] if self.targets_spec else None
        for tid, label in self.targets_spec:
            cb = Gtk.CheckButton(label=label, active=tid == first)
            cb.connect("toggled", self._on_targets)
            self.checks[tid] = cb
            flow.append(cb)
        row.add_prefix(flow)
        tgroup.add(row)
        shortcuts = Gtk.Box(spacing=8, margin_top=8)
        every = Gtk.Button(label="Everything")
        every.connect("clicked", lambda *_: self._set_targets({t for t, _l in self.targets_spec}))
        only_kb = Gtk.Button(label="Keyboard only", visible=self.kb_type != "none" and bool(self.zones))
        only_kb.connect("clicked", lambda *_: self._set_targets({"keyboard"}))
        only_ch = Gtk.Button(label="Chassis only", visible=self.kb_type != "none" and bool(self.zones))
        only_ch.connect("clicked", lambda *_: self._set_targets(set(self.zones)))
        for b in (every, only_kb, only_ch):
            shortcuts.append(b)
        tgroup.add(shortcuts)

        group = Adw.PreferencesGroup(title="Effect")
        self.add(group)
        self.combo = Adw.ComboRow(title="Effect")
        self.combo.connect("notify::selected", self._on_effect)
        group.add(self.combo)
        self.tempo = Adw.SpinRow.new_with_range(1, 30, 1)
        self.tempo.set_title("Tempo")
        self.tempo.set_subtitle("1 to 30: higher is slower (wave loops in ≈ 0.6 s × tempo)")
        self.tempo.set_value(7)
        group.add(self.tempo)
        self.row1, self.c1 = color_row("Color 1", (255, 0, 0))
        group.add(self.row1)
        self.row2, self.c2 = color_row("Color 2", (0, 0, 255))
        group.add(self.row2)
        self.how = plain_row("How it runs")
        self.how.set_subtitle_lines(4)
        group.add(self.how)
        self.apply_btn = Gtk.Button(label="Apply", halign=Gtk.Align.CENTER, margin_top=18,
                                    css_classes=["suggested-action", "pill"])
        self.apply_btn.connect("clicked", self._apply)
        group.add(self.apply_btn)
        self._on_targets()

    # --- targets / catalog ------------------------------------------------------
    def _set_targets(self, targets):
        self.syncing = True
        for tid, cb in self.checks.items():
            cb.set_active(tid in targets)
        self.syncing = False
        self._on_targets()

    def targets(self):
        return [t for t, cb in self.checks.items() if cb.get_active()]

    def _on_targets(self, *_):
        if self.syncing:
            return
        chosen = self.targets()
        previous = self._effect_id()
        kb = "keyboard" in chosen
        zone_fx = [set(self.zones[t].get("effects", ["static"])) for t in chosen if t != "keyboard"]
        self.entries = [e for e, _l, zone, _n in EFFECTS
                        if (not kb or e in self.available) and all(zone in fx for fx in zone_fx)]
        self.combo.set_model(Gtk.StringList.new([EFFECT_LABEL[e] for e in self.entries]))
        self.combo.set_selected(self.entries.index(previous) if previous in self.entries else 0)
        self.apply_btn.set_sensitive(bool(chosen))
        self._on_effect()

    def _effect_id(self):
        i = self.combo.get_selected()
        return self.entries[i] if 0 <= i < len(self.entries) else None

    def _on_effect(self, *_):
        eid = self._effect_id()
        if eid is None:
            return
        n = EFFECT_COLORS[eid]
        self.row1.set_visible(n >= 1)
        self.row2.set_visible(n >= 2)
        self.row1.set_title("Star color" if eid == "starlight" else "Color 1")
        self.row2.set_title("Background" if eid == "starlight" else "Color 2")
        self.tempo.set_visible(eid not in ("static", "gradient"))
        lines = []
        for t in self.targets():
            name = dict(self.targets_spec)[t]
            if t == "keyboard" and self.kb_type == "zones":
                how = "keyboard zones, run by the lighting controller"
            elif t == "keyboard":
                how = ("software animation rendered by the service" if eid in SOFTWARE
                       else "keyboard firmware effect")
                if eid == "static":
                    how = "whole keyboard, one color"
            elif eid == "static":
                how = "controller static color"
            else:
                how = "controller action"
            if t != "keyboard" and not self.zones[t].get("verified"):
                how += " (this zone is not verified on this model)"
            elif t != "keyboard" and eid not in ("static",) and self.zones[t].get("note"):
                how += f" ({self.zones[t]['note']})"
            lines.append(f"{name}: {how}")
        self.how.set_subtitle("\n".join(lines) or "Pick at least one target.")

    # --- apply ------------------------------------------------------------------------
    def _apply(self, _btn):
        eid = self._effect_id()
        if eid is None:
            return
        tempo = int(self.tempo.get_value())
        c1, c2 = rgb_from_rgba(self.c1.get_rgba()), rgb_from_rgba(self.c2.get_rgba())
        for t in self.targets():
            if t == "keyboard":
                if eid == "static":
                    self.win.call("SetKeyboardColor", GLib.Variant("(yyy)", c1))
                else:
                    self.win.call("SetKeyboardEffect", GLib.Variant("(sy(yyy)(yyy))", (eid, tempo, c1, c2)))
            else:
                self.win.call("SetZoneEffect",
                              GLib.Variant("(ssy(yyy)(yyy))", (t, EFFECT_ZONE[eid], tempo, c1, c2)))

    def update(self, state):
        eff = state.get("keyboard", {}).get("effect")
        if not eff or eff == self.last_effect or self.targets() != ["keyboard"]:
            return
        self.last_effect = eff
        if state.get("keyboard", {}).get("mode") == "effect" and eff.get("name") in self.entries:
            self.combo.set_selected(self.entries.index(eff["name"]))
        self.tempo.set_value(eff.get("tempo", 7))
        self.c1.set_rgba(rgba_from_rgb(eff.get("c1", (255, 0, 0))))
        self.c2.set_rgba(rgba_from_rgb(eff.get("c2", (0, 0, 255))))


class ChassisPage(Adw.PreferencesPage):
    DESCRIPTION = "Picking a color sets a static color and applies it at once."

    def __init__(self, win, zones, title="Chassis zones"):
        super().__init__()
        self.win = win
        self.syncing = False
        self.zones = {}
        text = self.DESCRIPTION
        if any("pulse" in z.get("effects", []) for z in zones):
            text += " Pulse and morph effects are set from the Effects page."
        if any(z.get("role") == "power" or z["id"] == "power" for z in zones):
            text += " Reprogramming the power button takes about 2 s (the spinner turns meanwhile)."
        group = Adw.PreferencesGroup(title=title, description=text)
        self.add(group)
        for zone in zones:
            row = plain_row(zone.get("label", zone["id"]))
            spinner = Gtk.Spinner(valign=Gtk.Align.CENTER, visible=False)
            button = color_button((255, 255, 255))
            button.connect("notify::rgba", self._on_color, zone["id"])
            row.add_suffix(spinner)
            row.add_suffix(button)
            row.set_activatable_widget(button)
            group.add(row)
            self.zones[zone["id"]] = {"button": button, "spinner": spinner, "busy": False, "pending": None,
                                      "row": row, "verified": zone.get("verified", True)}

    def _on_color(self, button, _pspec, zone):
        if self.syncing:
            return
        z = self.zones[zone]
        z["pending"] = rgb_from_rgba(button.get_rgba())
        if not z["busy"]:
            self._send(zone)

    def _send(self, zone):
        z = self.zones[zone]
        rgb, z["pending"] = z["pending"], None
        z["busy"] = True
        z["spinner"].set_visible(True)
        z["spinner"].start()

        def done(_res, _err):
            z["busy"] = False
            if z["pending"] is not None:
                self._send(zone)
            else:
                z["spinner"].stop()
                z["spinner"].set_visible(False)

        self.win.call("SetZoneColor", GLib.Variant("(syyy)", (zone, *rgb)), done)

    def update(self, state):
        self.syncing = True
        fx = state.get("zone_effects", {})
        for zone, rgb in state.get("zones", {}).items():
            z = self.zones.get(zone)
            if z and not z["busy"]:
                z["button"].set_rgba(rgba_from_rgb(rgb))
            if z:
                e = fx.get(zone, {"name": "static"})
                text = "Static color" if e["name"] == "static" else \
                    f"{e['name'].title()} · tempo {e.get('tempo', '?')} (set in Effects)"
                if not z["verified"]:
                    text += " · not verified on this model"
                z["row"].set_subtitle(text)
        self.syncing = False


class RipplePage(Adw.PreferencesPage):
    """Typing ripple settings. The service draws the rings and saves the
    settings, so the Quick Settings toggle and this page stay in step."""

    PRIVACY = ("While the ripple is on, the lighting service reads which keys of the built-in "
               "keyboard are pressed, to start a ring there. Nothing else is done with them: "
               "they are not recorded, logged or sent anywhere. External keyboards are not read.")

    def __init__(self, win):
        super().__init__()
        self.win = win
        self.syncing = False
        self.speed_debounce = Debounce(250, self._send)

        notice = Adw.PreferencesGroup()
        card = Gtk.Box(spacing=12, css_classes=["card"])
        card.append(Gtk.Image(icon_name="security-high-symbolic", pixel_size=32,
                              margin_start=14, margin_top=12, margin_bottom=12))
        card.append(Gtk.Label(label=self.PRIVACY, wrap=True, xalign=0, hexpand=True,
                              margin_end=14, margin_top=12, margin_bottom=12))
        notice.add(card)
        self.add(notice)

        group = Adw.PreferencesGroup()
        self.add(group)
        self.switch = Adw.SwitchRow(title="Enable", subtitle="Off by default. Each key you type "
                                                             "sends a ripple across the keyboard.")
        self.switch.connect("notify::active", self._send)
        group.add(self.switch)
        row, self.fg = color_row("Ripple color", (255, 110, 0), self._send)
        group.add(row)
        self.speed = Adw.SpinRow.new_with_range(*RIPPLE_SPEEDS, 1)
        self.speed.set_title("Wave speed")
        self.speed.set_subtitle("Keys per second (the ring always travels about 9 keys)")
        self.speed.set_value(RIPPLE_SPEED)
        self.speed.connect("notify::value", lambda *_: self.syncing or self.speed_debounce.trigger())
        group.add(self.speed)
        self.under = Adw.ComboRow(title="Under the ripple", model=Gtk.StringList.new(
            ["Current effect", "Background color"]))
        self.under.connect("notify::selected", self._send)
        group.add(self.under)
        self.bg_row, self.bg = color_row("Background color", (0, 0, 25), self._send)
        group.add(self.bg_row)
        try_it = Adw.PreferencesGroup(title="Try it",
                                      description="Any key of the built-in keyboard works, in any window.")
        try_it.add(Gtk.Entry(placeholder_text="Type here…"))
        self.add(try_it)
        self._show_under()

    def _show_under(self):
        effect = self.under.get_selected() == 0
        self.bg_row.set_visible(not effect)
        self.under.set_subtitle(
            "Firmware effects are redrawn, so may differ slightly" if effect else "One color for every key")

    def _send(self, *_):
        self._show_under()
        if self.syncing:
            return
        self.win.call("SetRipple", GLib.Variant("(b(yyy)ys(yyy))", (
            self.switch.get_active(), rgb_from_rgba(self.fg.get_rgba()), int(self.speed.get_value()),
            "effect" if self.under.get_selected() == 0 else "color", rgb_from_rgba(self.bg.get_rgba()))))

    def update(self, state):
        rp = state.get("ripple")
        if not rp or self.speed_debounce.pending:
            return
        self.syncing = True
        self.switch.set_active(bool(rp.get("enabled")))
        self.fg.set_rgba(rgba_from_rgb(rp.get("color", (255, 110, 0))))
        self.speed.set_value(rp.get("speed", RIPPLE_SPEED))
        self.under.set_selected(0 if rp.get("under", "effect") == "effect" else 1)
        self.bg.set_rgba(rgba_from_rgb(rp.get("background", (0, 0, 25))))
        self._show_under()
        self.syncing = False


